# Runtime (pooled) PostgreSQL connection — Neon pooler endpoint
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (session) connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="604800"

# One-time administrator bootstrap. Disable by removing after use.
ADMIN_BOOTSTRAP_SECRET="replace-with-a-long-random-one-time-secret"

FRONTEND_ORIGIN="http://localhost:4000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
RESERVATION_TTL_MINUTES="15"
NODE_ENV="development"
PORT="4000"
